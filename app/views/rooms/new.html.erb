<h1>施設登録</h1>

<% if flash[:alert] %>

<p>

<%= flash[:alert] %>

</p>

<br>

<% end %>

<%= form_with(
  model: @room,
  local: true,
  html: {
    multipart: true
  }
) do |f| %>

<p>

施設名

<br>

<%= f.text_field :name %>

</p>

<p>

施設説明

<br>

<%= f.text_area :introduction %>

</p>

<p>

料金

<br>

<%= f.number_field :price %>

</p>

<p>

住所

<br>

<%= f.text_field :address %>

</p>

<p>

施設画像

<br>

<%= f.file_field :image %>

</p>

<br>

<%= f.submit "登録する" %>

<% end %>
