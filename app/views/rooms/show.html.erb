<h1>施設詳細</h1>

<hr>

<% if @room.image.attached? %>

<%= image_tag(
@room.image,
width: 400
) %>

<% else %>

<%= image_tag(
"default_room.png",
width: 400
) %>

<% end %>

<br><br>

<h2>

<%= @room.name %>

</h2>

<p>

施設説明：

<%= @room.introduction %>

</p>

<p>

料金：

¥<%= number_with_delimiter(
@room.price
) %>/日

</p>

<p>

住所：

<%= @room.address %>

</p>

<hr>

<% if user_signed_in? %>

<%= link_to(
"予約する",
new_room_reservation_path(@room)
) %>

<br><br>

<% if @room.user == current_user %>

<%= link_to(
"編集",
edit_room_path(@room)
) %>

<% end %>

<% end %>

<br><br>

<%= link_to(
"一覧へ戻る",
rooms_path
) %>
