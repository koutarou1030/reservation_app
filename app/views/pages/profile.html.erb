<h1>プロフィール編集</h1>

<%= form_with(
model: current_user,
url: profile_path,
method: :patch,
html: {
multipart: true
}
) do |f| %>

<div>

名前

<br>

<%= f.text_field :name %>

</div>

<br>

<div>

自己紹介

<br>

<%= f.text_area :introduction %>

</div>

<br>

<div>

画像

<br>

<%= f.file_field :image %>

</div>

<br>

<%= f.submit "更新" %>

<% end %>
