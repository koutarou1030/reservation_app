<h1>アカウント情報</h1>

<% if current_user.image.attached? %>

<%= image_tag(
current_user.image,
width: 150
) %>

<% else %>

<%= image_tag(
"default_user.png",
width: 150
) %>

<% end %>

<br><br>

<p>

名前：

<%= current_user.name %>

</p>

<p>

メール：

<%= current_user.email %>

</p>

<p>

パスワード：

********

</p>

<p>

自己紹介：

<br>

<%= current_user.introduction %>

</p>

<br>

<%= link_to(
"プロフィール編集",
profile_path
) %>
