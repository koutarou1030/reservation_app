<!DOCTYPE html>
<html>

<head>

  <title>宿泊予約アプリ</title>

  <%= csrf_meta_tags %>

  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application" %>

  <%= javascript_importmap_tags %>

</head>

<body>

<header>

<%= link_to "TOP", root_path %>

&nbsp;

<% if user_signed_in? %>

ようこそ

<details style="display:inline;">

<summary style="display:inline; cursor:pointer;">

<% if current_user.image.attached? %>

<%= image_tag(
current_user.image,
width:40,
height:40
) %>

<% else %>

<%= image_tag(
"default_user.png",
width:40,
height:40
) %>

<% end %>

<%= current_user.name %>

</summary>

<div>

<%= link_to(
"マイページ",
account_path
) %>

<br>

<%= link_to(
"施設一覧",
rooms_path
) %>

<br>

<%= link_to(
"予約一覧",
reservations_path
) %>

<br><br>

<%= button_to(
"ログアウト",
destroy_user_session_path,
method: :delete
) %>

</div>

</details>

<% else %>

|

<%= link_to(
"ログイン",
new_user_session_path
) %>

|

<%= link_to(
"新規登録",
new_user_registration_path
) %>

<% end %>

<hr>

</header>

<%= yield %>

</body>

</html>
